[Unit]
Description=Review Activator Stage20 Yandex contract drift diagnostic
ConditionHost=v3248121.hosted-by-vdsina.ru
After=review-yandex-lifecycle.service review-ai-contract-drift.service
Wants=review-yandex-lifecycle.service review-ai-contract-drift.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/review-activator-contract-drift/current
ExecStart=/opt/node/bin/node /opt/review-activator-contract-drift/current/tools/yandex-contract-drift/contract-drift-manager.mjs
ExecStartPost=/opt/node/bin/node /opt/review-activator-contract-drift/current/tools/yandex-contract-drift/drift-ai-once.mjs
StateDirectory=review-activator-ops
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=90
Restart=no
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/review-activator-ops
InaccessiblePaths=-/etc/review-activator-yandex -/opt/review-activator-reply -/var/backups/review-activator
LimitCORE=0
StandardInput=null
StandardOutput=journal
StandardError=journal
