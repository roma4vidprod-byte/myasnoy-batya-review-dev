[Unit]
Description=Review Activator Stage17 safe AI Ops telemetry collector
ConditionHost=v3248121.hosted-by-vdsina.ru
After=review-yandex-lifecycle.service
Wants=review-yandex-lifecycle.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/review-activator-ai-ops/current
ExecStart=/opt/node/bin/node /opt/review-activator-ai-ops/current/tools/ai-ops/ops-telemetry-collector.mjs
StateDirectory=review-activator-ops
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=20
Restart=no
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/review-activator-ops
LimitCORE=0
StandardInput=null
StandardOutput=journal
StandardError=journal
