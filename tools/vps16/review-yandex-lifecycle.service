[Unit]
Description=Review Activator Stage16 Yandex session lifecycle snapshot
ConditionHost=v3248121.hosted-by-vdsina.ru
After=postgresql@17-main.service
Requires=postgresql@17-main.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/review-activator-lifecycle/current
ExecStart=/opt/node/bin/node /opt/review-activator-lifecycle/current/tools/vps16/session-lifecycle-manager.mjs
Environment=RA_STAGE16_MODE=snapshot
StateDirectory=review-activator-ops
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=35
TimeoutStopSec=5
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/review-activator-ops
MemoryHigh=96M
MemoryMax=160M
TasksMax=64
LimitCORE=0
StandardInput=null
StandardOutput=journal
StandardError=journal
