[Unit]
Description=Review Activator Stage19 Yandex operator fallback state manager
ConditionHost=v3248121.hosted-by-vdsina.ru
After=review-ai-ops-recovery.service postgresql@17-main.service
Requires=postgresql@17-main.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/review-activator-operator-fallback/current
ExecStart=/opt/node/bin/node /opt/review-activator-operator-fallback/current/tools/yandex-operator-fallback/operator-fallback-manager.mjs
Environment=RA_STAGE19_MODE=ingest
StateDirectory=review-activator-ops
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=30
Restart=no
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/review-activator-ops
InaccessiblePaths=-/etc/review-activator-yandex -/opt/review-activator-yandex -/opt/review-activator-yandex-browser -/opt/review-activator-reply -/var/backups/review-activator
LimitCORE=0
StandardInput=null
StandardOutput=journal
StandardError=journal
