[Unit]
Description=Review Activator real Yandex review sync (read + DB persistence only)
After=network-online.target postgresql@17-main.service review-lab-auth.service review-lab-api.service review-activator-foundation.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=RA_EXPECTED_HOSTNAME=v3248121.hosted-by-vdsina.ru
ExecStart=/usr/bin/python3 -B /opt/review-activator-yandex/tools/vps10/provider_once.py
TimeoutStartSec=90
TimeoutStopSec=10
Restart=no
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/review-activator-ops
InaccessiblePaths=/var/backups/review-activator /etc/review-activator-lab
MemoryMax=256M
TasksMax=64
